{
  "openapi": "3.1.0",
  "info": {
    "title": "Croviq API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Service Health Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Service health status",
            "default": "ok"
          },
          "service": {
            "type": "string",
            "title": "Service",
            "description": "Service identifier",
            "default": "croviq-api"
          },
          "git_sha": {
            "type": "string",
            "title": "Git Sha",
            "description": "Current git commit SHA or environment identifier"
          }
        },
        "type": "object",
        "required": ["git_sha"],
        "title": "HealthResponse"
      }
    }
  }
}
