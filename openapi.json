{
  "openapi": "3.1.0",
  "info": {
    "title": "Croviq API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Service Health Check",
        "operationId": "health_check_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/client-events": {
      "post": {
        "tags": ["Auth"],
        "summary": "Record Sanitized Client Authentication Event",
        "description": "Record a constrained client auth event without accepting sensitive payloads.",
        "operationId": "record_client_auth_event_api_client_events_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/AuthLoginAttemptEvent"
                  },
                  {
                    "$ref": "#/components/schemas/AuthLoginFailedEvent"
                  },
                  {
                    "$ref": "#/components/schemas/ClientErrorEvent"
                  }
                ],
                "title": "Event",
                "discriminator": {
                  "propertyName": "event_type",
                  "mapping": {
                    "auth.login_attempt": "#/components/schemas/AuthLoginAttemptEvent",
                    "auth.login_failed": "#/components/schemas/AuthLoginFailedEvent",
                    "client.error": "#/components/schemas/ClientErrorEvent"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Record Client Auth Event Api Client Events Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Get Current Authenticated User",
        "description": "Retrieve the canonical User profile derived from verified identity.",
        "operationId": "get_me_api_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Record User Logout",
        "description": "Record client-side logout activity and emit operational audit log.",
        "operationId": "logout_api_auth_logout_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Logout Api Auth Logout Post"
                }
              }
            }
          }
        }
      }
    },
    "/api/workspace": {
      "get": {
        "tags": ["Workspaces"],
        "summary": "Get or Provision Default Workspace",
        "description": "Retrieve the default workspace belonging to the verified creator. If none exists, creates exactly one default Workspace idempotently.",
        "operationId": "get_or_provision_default_workspace_api_workspace_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/channel/memory/profile": {
      "get": {
        "tags": ["Memory"],
        "summary": "Retrieve Channel Memory Profile",
        "description": "Retrieve the canonical structured ChannelMemoryProfile from Memory Bank.",
        "operationId": "get_channel_memory_profile_api_channel_memory_profile_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "channel_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Canonical channel identifier.",
              "default": "croviq_syn_ai_eng_01",
              "title": "Channel Id"
            },
            "description": "Canonical channel identifier."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChannelMemoryProfile"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/channel/memory/lessons": {
      "get": {
        "tags": ["Memory"],
        "summary": "Retrieve Channel Lessons",
        "description": "Retrieve active ChannelLessons scoped to a channel, optionally filtered by target agent.",
        "operationId": "get_channel_lessons_api_channel_memory_lessons_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "channel_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Canonical channel identifier.",
              "default": "croviq_syn_ai_eng_01",
              "title": "Channel Id"
            },
            "description": "Canonical channel identifier."
          },
          {
            "name": "target_agent",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/TargetAgent"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional filter by target agent (director, editor, packaging, qa).",
              "title": "Target Agent"
            },
            "description": "Optional filter by target agent (director, editor, packaging, qa)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ChannelLesson"
                  },
                  "title": "Response Get Channel Lessons Api Channel Memory Lessons Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthLoginAttemptEvent": {
        "properties": {
          "event_type": {
            "type": "string",
            "const": "auth.login_attempt",
            "title": "Event Type"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["event_type"],
        "title": "AuthLoginAttemptEvent"
      },
      "AuthLoginFailedEvent": {
        "properties": {
          "event_type": {
            "type": "string",
            "const": "auth.login_failed",
            "title": "Event Type"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string",
                "enum": ["invalid_credentials", "demo_access_restricted"]
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["event_type"],
        "title": "AuthLoginFailedEvent"
      },
      "BrandKit": {
        "properties": {
          "tone": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tone",
            "description": "Tone adjectives or stylistic descriptors (e.g. ['concise', 'informative'])"
          },
          "target_audience": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Audience",
            "description": "Description of the target audience and viewer demographic"
          },
          "content_style": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Style",
            "description": "Primary video content style or genre"
          },
          "custom_instructions": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Custom Instructions",
            "description": "Custom production instructions and brand guidelines"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "BrandKit",
        "description": "Canonical BrandKit configuration model for a Croviq Workspace."
      },
      "ChannelLesson": {
        "properties": {
          "lesson_id": {
            "type": "string",
            "title": "Lesson Id",
            "description": "Unique identifier for the lesson.",
            "examples": ["lsn_early_demo_01"]
          },
          "channel_id": {
            "type": "string",
            "title": "Channel Id",
            "description": "Channel identifier scope.",
            "examples": ["croviq_syn_ai_eng_01"]
          },
          "directive": {
            "type": "string",
            "title": "Directive",
            "description": "Actionable instruction for the agent.",
            "examples": ["Reach the first concrete demonstration before 00:30."]
          },
          "target_agent": {
            "$ref": "#/components/schemas/TargetAgent",
            "description": "Agent role this lesson directs (director, editor, packaging, qa)."
          },
          "evidence_summary": {
            "type": "string",
            "title": "Evidence Summary",
            "description": "Statistical or qualitative summary of evidence supporting this directive.",
            "examples": [
              "Videos with first demo <= 30s average 58.4% retention vs 44.1% for late demos."
            ]
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "description": "Confidence score for this lesson (0.0 to 1.0).",
            "examples": [0.92]
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Lifecycle status of this lesson (active, deprecated, experimental).",
            "default": "active"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "Timestamp when this lesson was recorded (UTC)."
          }
        },
        "type": "object",
        "required": [
          "lesson_id",
          "channel_id",
          "directive",
          "target_agent",
          "evidence_summary",
          "confidence"
        ],
        "title": "ChannelLesson",
        "description": "Structured, evidence-backed editorial rule for a specific agent role."
      },
      "ChannelMemoryProfile": {
        "properties": {
          "channel_id": {
            "type": "string",
            "title": "Channel Id",
            "description": "Canonical channel identifier used as memory scope.",
            "examples": ["croviq_syn_ai_eng_01"]
          },
          "channel_name": {
            "type": "string",
            "title": "Channel Name",
            "description": "Display name of the channel.",
            "examples": ["AI Engineering & Agent Systems"]
          },
          "primary_topics": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Primary Topics",
            "description": "Top subject-matter domains covered by the channel.",
            "examples": [["AI Agents", "LLM Systems", "DevOps & CI/CD"]]
          },
          "content_pillars": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Content Pillars",
            "description": "Core content themes and recurring series pillars.",
            "examples": [["Agent Architecture", "Production Deployment", "Emerging AI Releases"]]
          },
          "language": {
            "type": "string",
            "title": "Language",
            "description": "Primary spoken and metadata language (ISO 639-1 code).",
            "default": "en"
          },
          "audience_geographies": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Audience Geographies",
            "description": "Top audience geography ISO country codes ordered by viewership volume.",
            "examples": [["US", "IN", "GB", "CA", "DE"]]
          },
          "audience_characteristics": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Audience Characteristics",
            "description": "Key audience behavioral and demographic attributes.",
            "examples": [
              ["Software Engineers", "DevOps / SRE Practitioners", "High desktop viewing share"]
            ]
          },
          "historical_baselines": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Historical Baselines",
            "description": "Baseline performance benchmarks (e.g. views, CTR, retention, duration)."
          },
          "high_performing_formats": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "High Performing Formats",
            "description": "Video formats demonstrating above-average performance.",
            "examples": [["agent_build", "deep_dive"]]
          },
          "weak_formats": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Weak Formats",
            "description": "Video formats demonstrating below-average performance.",
            "examples": [["tutorial"]]
          },
          "recurring_retention_patterns": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Recurring Retention Patterns",
            "description": "Distilled retention observations from historical video performance."
          },
          "packaging_patterns": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Packaging Patterns",
            "description": "Distilled CTR and packaging observations (titles, topics, thumbnails)."
          },
          "editorial_directives": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Editorial Directives",
            "description": "Actionable editorial rules derived from channel evidence."
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At",
            "description": "Timestamp when this memory profile was generated or updated (UTC)."
          }
        },
        "type": "object",
        "required": ["channel_id", "channel_name"],
        "title": "ChannelMemoryProfile",
        "description": "Canonical structured memory profile for a channel stored in Memory Bank."
      },
      "ClientErrorEvent": {
        "properties": {
          "event_type": {
            "type": "string",
            "const": "client.error",
            "title": "Event Type"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["event_type"],
        "title": "ClientErrorEvent"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Service health status",
            "default": "ok"
          },
          "service": {
            "type": "string",
            "title": "Service",
            "description": "Service identifier",
            "default": "croviq-api"
          },
          "git_sha": {
            "type": "string",
            "title": "Git Sha",
            "description": "Current git commit SHA or environment identifier"
          }
        },
        "type": "object",
        "required": ["git_sha"],
        "title": "HealthResponse"
      },
      "TargetAgent": {
        "type": "string",
        "enum": ["director", "editor", "packaging", "qa"],
        "title": "TargetAgent"
      },
      "User": {
        "properties": {
          "user_id": {
            "type": "string",
            "minLength": 1,
            "title": "User Id",
            "description": "Unique user identifier (e.g. Firebase UID / Google sub)"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email",
            "description": "Canonical user email address"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "title": "Display Name",
            "description": "User display name"
          },
          "avatar_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avatar Url",
            "description": "Profile avatar image URL"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "Timestamp when the user was created (UTC)"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At",
            "description": "Timestamp when the user was last updated (UTC)"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["user_id", "email", "display_name", "created_at", "updated_at"],
        "title": "User",
        "description": "Canonical User identity model for Croviq."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": ["loc", "msg", "type"],
        "title": "ValidationError"
      },
      "Workspace": {
        "properties": {
          "workspace_id": {
            "type": "string",
            "minLength": 1,
            "title": "Workspace Id",
            "description": "Unique workspace identifier"
          },
          "owner_user_id": {
            "type": "string",
            "minLength": 1,
            "title": "Owner User Id",
            "description": "Identifier of the user who owns this workspace"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name",
            "description": "Workspace / channel display name"
          },
          "channel_description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Channel Description",
            "description": "Description of the YouTube channel or production context"
          },
          "brand_kit": {
            "$ref": "#/components/schemas/BrandKit",
            "description": "Workspace brand kit configuration"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "Timestamp when the workspace was created (UTC)"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At",
            "description": "Timestamp when the workspace was last updated (UTC)"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["workspace_id", "owner_user_id", "name", "created_at", "updated_at"],
        "title": "Workspace",
        "description": "Canonical Workspace tenant container model for Croviq."
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "description": "Identity Platform / Firebase ID Token: 'Bearer <TOKEN>'",
        "scheme": "bearer"
      }
    }
  }
}
