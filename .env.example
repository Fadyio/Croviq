# =============================================================================
# Croviq Local Environment Configuration Template (.env.example)
# =============================================================================
# Copy this file to .env for local backend and full-stack development:
#   cp .env.example .env
#
# DO NOT commit real secrets or private credentials to git.
# Actual .env and .env.local files are ignored by git.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CORE RUNTIME CONFIGURATION (Optional - Local Defaults Provided)
# -----------------------------------------------------------------------------
# Execution environment mode: 'development', 'staging', or 'production'
# Category: OPTIONAL | LOCAL DEFAULT: development
ENVIRONMENT=development
CROVIQ_ENV=development

# Server port for the FastAPI backend
# Category: OPTIONAL | LOCAL DEFAULT: 8080
PORT=8080

# Git commit SHA (auto-detected via git in development, or set explicitly)
# Category: OPTIONAL | LOCAL DEFAULT: auto-detected or "local"
GIT_SHA=local

# Allowed creator emails for authentication (comma-separated).
# In local development / fake mode, requests with these emails are accepted.
# In production, login fails closed unless creator email is in this list.
# Category: OPTIONAL in local fake mode / REQUIRED for authenticated access
CROVIQ_ALLOWED_EMAILS=demo@croviq.app,fadynagh10@gmail.com

# -----------------------------------------------------------------------------
# 2. GOOGLE CLOUD & VERTEX AI (Required only for Google-backed integration mode)
# -----------------------------------------------------------------------------
# Google Cloud Project ID
# Category: OPTIONAL for local fake mode | REQUIRED for Google-backed mode
# Example: croviq-506602
GCP_PROJECT_ID=croviq-506602

# Google Cloud Region for regional resources
# Category: OPTIONAL | LOCAL DEFAULT: us-central1
GCP_REGION=us-central1

# Vertex AI Model Location (Gemini models)
# Category: OPTIONAL | LOCAL DEFAULT: global
VERTEXAI_LOCATION=global

# Gemini Model ID for agent reasoning (Leo Dialogue Editor, Maya Director)
# Category: OPTIONAL | LOCAL DEFAULT: gemini-3.7-flash
GEMINI_MODEL_ID=gemini-3.7-flash

# Canonical Speech Transcription Model (Gemini 3.5 Transcribe Preview)
# Category: OPTIONAL | LOCAL DEFAULT: gemini-3.5-transcribe-preview
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe-preview

# Gemini Transcription Location
# Category: OPTIONAL | LOCAL DEFAULT: global
GEMINI_TRANSCRIPTION_LOCATION=global

# -----------------------------------------------------------------------------
# 3. SERVICE PROVIDERS (Fake/Deterministic vs Google-backed)
# -----------------------------------------------------------------------------
# GenAI Provider: 'fake' (deterministic mock for tests) or 'google' (Vertex AI)
# Category: OPTIONAL | LOCAL DEFAULT: fake (auto 'google' in production)
GENAI_BACKEND_PROVIDER=fake

# Media Storage Provider: 'fake' (in-memory mock) or 'google' (GCS bucket)
# Category: OPTIONAL | LOCAL DEFAULT: fake (auto 'google' in production)
MEDIA_STORAGE_PROVIDER=fake

# Memory Store Provider: 'fake' (in-memory mock) or 'google' (Google Agent Platform Memory Bank)
# Category: OPTIONAL | LOCAL DEFAULT: fake (auto 'google' in production)
MEMORY_STORE_PROVIDER=fake

# Speech Transcription Service: 'fake' (deterministic mock) or 'google' (Gemini Transcribe)
# Category: OPTIONAL | LOCAL DEFAULT: fake (auto 'google' in production)
SPEECH_SERVICE_PROVIDER=fake

# -----------------------------------------------------------------------------
# 4. STORAGE & MEMORY BANK (Optional - defaults derived from Project ID)
# -----------------------------------------------------------------------------
# GCS Media Bucket Name (defaults to {GCP_PROJECT_ID}-croviq-media-raw)
# Category: OPTIONAL | LOCAL DEFAULT: derived
MEDIA_BUCKET_NAME=croviq-media-raw

# Signed URL expiry duration in seconds
# Category: OPTIONAL | LOCAL DEFAULT: 900 (15 minutes)
SIGNED_URL_EXPIRY_SECONDS=900

# Maximum allowed media upload file size in bytes
# Category: OPTIONAL | LOCAL DEFAULT: 524288000 (500 MB)
MAX_UPLOAD_SIZE_BYTES=524288000

# Memory Bank ID in Google Agent Platform
# Category: OPTIONAL | LOCAL DEFAULT: croviq-channel-memory
MEMORY_BANK_ID=croviq-channel-memory

# Memory Bank Location
# Category: OPTIONAL | LOCAL DEFAULT: us-central1
MEMORY_BANK_LOCATION=us-central1

# -----------------------------------------------------------------------------
# 5. GOOGLE AUTHENTICATION NOTE
# -----------------------------------------------------------------------------
# Local development with real Google services uses Application Default Credentials (ADC).
# Run: gcloud auth application-default login
# Do NOT place service account JSON keys or API secrets in this file.
# In production, Cloud Run service account ADC is used automatically.
# In CI/CD, Workload Identity Federation (WIF) is used.
# =============================================================================
