{
  "name": "croviq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "dev": "pnpm --filter @croviq/web dev",
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "export:openapi": "uv run --directory apps/api python ../../scripts/export_openapi.py",
    "e2e": "pnpm --filter @croviq/web e2e",
    "test:e2e": "pnpm --filter @croviq/web test:e2e",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f web"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "typescript": "^5.9.3"
  }
}
