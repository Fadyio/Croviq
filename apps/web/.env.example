# =============================================================================
# Croviq Web (Frontend) Environment Configuration Template (.env.example)
# =============================================================================
# Copy this file to apps/web/.env.local for local frontend development:
#   cp apps/web/.env.example apps/web/.env.local
#
# IMPORTANT:
# - All VITE_* variables are bundled into the public browser client artifact.
# - NEVER put private server secrets, service account credentials, or admin keys in this file.
# - Actual .env.local and .env.* local files are ignored by git.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. FIREBASE / GOOGLE IDENTITY PLATFORM BROWSER CLIENT CONFIGURATION
# -----------------------------------------------------------------------------
# Firebase Web API Key for client-side authentication in browser
# Category: PUBLIC FRONTEND CONFIG | LOCAL EXAMPLE: your-firebase-web-api-key
VITE_FIREBASE_API_KEY=your-firebase-web-api-key

# Firebase Auth Domain for browser OAuth / Identity Platform redirects
# Category: PUBLIC FRONTEND CONFIG | LOCAL EXAMPLE: your-project.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com

# Firebase Project ID for browser client
# Category: PUBLIC FRONTEND CONFIG | LOCAL EXAMPLE: your-project-id
VITE_FIREBASE_PROJECT_ID=your-project-id

# -----------------------------------------------------------------------------
# 2. LOCAL DEV SERVER PROXY TARGET (Used by Vite dev server)
# -----------------------------------------------------------------------------
# Backend API server URL proxied by Vite dev server at /api
# Category: PUBLIC FRONTEND CONFIG / DEV ONLY | LOCAL DEFAULT: http://localhost:8080
API_PROXY_TARGET=http://localhost:8080
